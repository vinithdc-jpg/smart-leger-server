# PostgreSQL Database Connection URL
# Optional PEM-encoded CA certificate if the database certificate is not trusted by the system.
# Store newlines as \n when configuring this variable in deployment.
# DATABASE_SSL_CA=
# Local PostgreSQL does not require TLS; set true for remote TLS databases.
# Production enables TLS by default unless explicitly set to false (not recommended).
DATABASE_SSL=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_leader_db

# Secret key for signing JWT cookies/tokens
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Mistral API Key for AI features (Get one at https://console.mistral.ai)
Mistral_Api=your_mistral_api_key_here

# Optional: Mistral model designation
MISTRAL_MODEL=mistral-large-latest

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# Backend Express Server Port
PORT=5000
